# Required
OPENAI_API_KEY=your-openai-api-key

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=governed_rag

# Optional: Retrieval Configuration
# Number of documents to retrieve from vector DB
RETRIEVAL_TOP_K=8

# Skip reranking if documents <= this threshold (reranking is slower)
RERANK_THRESHOLD=8

# Maximum retrieval attempts (1 = single call, no retries)
MAX_RETRIEVAL_STEPS=1

# Minimum similarity score for documents (0.0 to 1.0)
VECTOR_SIMILARITY_THRESHOLD=0.4

# Optional: Model Configuration
EMBEDDING_MODEL=text-embedding-3-small